<?xml version="1.0" encoding="utf-8"?>
<!-- SensorStream launcher background: subtle radial "spotlight" on the app's dark surface.
     Full-bleed 108dp so the system mask (circle/squircle) crops cleanly. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="82"
                android:startColor="#1C2534"
                android:centerColor="#12161D"
                android:endColor="#0A0D12" />
        </aapt:attr>
    </path>
</vector>
